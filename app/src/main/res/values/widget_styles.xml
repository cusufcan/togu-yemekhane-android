<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Yemekhane.MenuSmall" parent="">
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/seyir_widget_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Yemekhane.MenuTitle" parent="">
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/seyir_widget_title</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Yemekhane.MenuRest" parent="">
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3sp</item>
